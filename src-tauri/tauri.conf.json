{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstaReport",
  "version": "9.0.1",
  "identifier": "com.instareport.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InstaReport",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#0D0D0D"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sidecar-bridge"
    ],
    "resources": {
      "../sidecar/browsers": "browsers"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
